SERVER_PORT=8080

# Database
POSTGRES_DB=course_aura_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Spring Boot Datasource Configuration (Localhost)
DATABASE_URL=jdbc:postgresql://localhost:5432/course_aura_db
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Alternative: Remote / Neon Cloud Database
# DATABASE_URL=jdbc:postgresql://<user>:<password>@<host>/<database>?sslmode=require
# DATABASE_URL_POOLED=jdbc:postgresql://<user>:<password>@<host>-pooler/<database>?sslmode=require


# JWT (JSON Web Token) Security Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000


# Google Cloud Console
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub Developer Settings
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Meta for Developers
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

# Frontend Application OAuth2 Callback Redirect
OAUTH2_REDIRECT_URI=http://localhost:3000/oauth2/redirect

COOKIE_SECURE=false

# Paid checkout: leave PAYMENT_PROVIDER empty to disable. "fake" moves no money, so never use it in production.
PAYMENT_PROVIDER=
PAYMENT_CURRENCY=USD
PAYMENT_WEBHOOK_SECRET=

# Optional domain bootstrap
DEMO_DATA_ENABLED=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PROMOTE_EMAILS=
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=
COOKIE_ACCESS_TOKEN_NAME=access_token
COOKIE_REFRESH_TOKEN_NAME=refresh_token
COOKIE_PATH=/
COOKIE_ACCESS_TOKEN_MAX_AGE=900
COOKIE_REFRESH_TOKEN_MAX_AGE=604800
COOKIE_HTTP_ONLY=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_TRACKED_CLIENTS=50000

# IPs/CIDRs of reverse proxies allowed to set X-Forwarded-For (comma-separated). Leave empty when not behind a proxy.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP). Defaults point at the local Mailpit container (web UI: http://localhost:8025).
# For production set your provider's host/port/credentials and enable auth + STARTTLS.
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_SMTP_STARTTLS_REQUIRED=false
MAIL_FROM=no-reply@courseaurahub.local
MAIL_FROM_NAME=CourseAuraHub

# Email verification (registration OTP)
EMAIL_OTP_LENGTH=6
EMAIL_OTP_TTL=10m
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_RESEND_COOLDOWN=60s
EMAIL_OTP_MAX_PER_HOUR=5

# File uploads (S3-compatible). Defaults match the local MinIO container (console: http://localhost:9001).
# Leave STORAGE_ENDPOINT empty to turn uploads off. Never use the default keys in production.
# On a real bucket, allow anonymous reads on public/* only, and allow PUT from your frontend origin in CORS.
STORAGE_ENDPOINT=
STORAGE_PUBLIC_ENDPOINT=
STORAGE_PUBLIC_URL=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
MINIO_API_PORT=
MINIO_CONSOLE_PORT=

# Certificates: public verification page printed on each PDF
CERTIFICATE_VERIFY_URL=http://localhost:3000/certificates

# Telegram notifications. Create a bot with @BotFather; leave the token empty to turn Telegram off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Production only: public URL ending in /api/v1/telegram/webhook, plus a random secret (openssl rand -hex 32).
# Leave the URL empty to poll Telegram, which works on localhost.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_APP_URL=http://localhost:3000

# Password reset
PASSWORD_RESET_URL=http://localhost:3000/auth/reset-password
PASSWORD_RESET_TTL=30m
PASSWORD_RESET_COOLDOWN=60s
PASSWORD_RESET_MAX_PER_HOUR=5

# Login lockout and sessions
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_DURATION=15m
SESSION_MAX_ACTIVE_PER_USER=10
SESSION_REMEMBER_ME_TTL=30d
SESSION_REUSE_GRACE_PERIOD=10s

# Two-factor authentication. Base64 32-byte key: openssl rand -base64 32
# Leave empty to keep 2FA enrollment unavailable. Never change it once users have enrolled.
MFA_ENCRYPTION_KEY=
MFA_ISSUER=CourseAuraHub

# Facebook exposes no email-verification flag; only set true if you accept Facebook emails as verified
OAUTH2_TRUST_FACEBOOK_EMAIL=false

# Logging (keep INFO in production; DEBUG on security may log request details)
LOG_LEVEL_APP=INFO
LOG_LEVEL_SECURITY=INFO
LOG_LEVEL_SQL=INFO

SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_JPA_SHOW_SQL=false

PGADMIN_EMAIL=admin@aura.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
