    {
      "name": "OAuth2",
      "description": "These requests verify the initial redirect only. Completing OAuth2 login requires provider credentials and a browser.",
      "item": [
        {
          "name": "Google Authorization Redirect",
          "protocolProfileBehavior": {
            "followRedirects": false
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 302\", () => pm.response.to.have.status(302));",
                  "pm.test(\"Redirects to Google authorization\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(\"/oauth2/authorization/google\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
