{
  "info": {
    "_postman_id": "4f9d6c2a-8b1e-4a7c-9f2d-3c5e7a1b9d04",
    "name": "Course Aura Hub - Auth API",
    "description": "Postman collection for the Course Aura Hub authentication module. Run the requests in order with the Collection Runner. Register creates a unique test account and both register/login automatically save the returned JWTs as collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "email",
      "value": "",
      "type": "string"
    },
    {
      "key": "password",
      "value": "P@ssword123",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "refreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "previousRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "lastRefreshToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "invalidToken",
      "value": "invalid.jwt.token",
      "type": "string"
    },
    {
      "key": "weakEmail",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Happy-path authentication flow. Run these requests in order.",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"email\", `postman_${Date.now()}@example.com`);",
                  "pm.collectionVariables.set(\"password\", \"P@ssword123\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Success flag is true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Access token is returned\", () => {",
                  "    pm.expect(json.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(json.data.accessToken.length).to.be.greaterThan(0);",
                  "});",
                  "pm.test(\"Refresh token is returned\", () => {",
                  "    pm.expect(json.data.refreshToken).to.be.a(\"string\");",
                  "    pm.expect(json.data.refreshToken.length).to.be.greaterThan(0);",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);",
                  "pm.collectionVariables.set(\"userId\", json.data.userId);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Postman\",\n  \"lastName\": \"Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "register"
              ]
            },
            "description": "Registers a unique local user. Returns tokens in both the JSON body and Set-Cookie headers."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Success flag is true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Tokens are returned\", () => {",
                  "    pm.expect(json.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(json.data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"rememberMe\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "description": "Logs in with the account created by Register and saves the new token pair."
          },
          "response": []
        },
        {
          "name": "Get Current User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Success flag is true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Returns the registered email\", () => pm.expect(json.data.email).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"Profile response does not expose tokens\", () => pm.expect(json.data).to.not.have.property(\"accessToken\"));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            },
            "description": "Requires a valid Bearer access token."
          },
          "response": []
        },
        {
          "name": "Refresh Token (body)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Success flag is true\", () => pm.expect(json.success).to.eql(true));",
                  "pm.test(\"Rotated tokens are returned\", () => {",
                  "    pm.expect(json.data.accessToken).to.be.a(\"string\");",
                  "    pm.expect(json.data.refreshToken).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"previousRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Sends the refresh token in the JSON body. The backend also accepts the refresh-token cookie."
          },
          "response": []
        },
        {
          "name": "Get Current User (after refresh)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"New access token is valid\", () => pm.expect(json.data.email).to.eql(pm.collectionVariables.get(\"email\")));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{accessToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Refresh Token (cookie only)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cookie-based refresh works\", () => pm.expect(json.success).to.eql(true));",
                  "pm.collectionVariables.set(\"accessToken\", json.data.accessToken);",
                  "pm.collectionVariables.set(\"refreshToken\", json.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Sends no body. Postman reuses the refresh_token cookie stored from Register/Login."
          },
          "response": []
        },
        {
          "name": "Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Logout message is returned\", () => pm.expect(json.message).to.eql(\"Logged out successfully\"));",
                  "pm.collectionVariables.set(\"lastRefreshToken\", pm.collectionVariables.get(\"refreshToken\"));",
                  "pm.collectionVariables.set(\"accessToken\", \"\");",
                  "pm.collectionVariables.set(\"refreshToken\", \"\");"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "logout"
              ]
            },
            "description": "Revokes the refresh token and clears the auth cookies."
          },
          "response": []
        },
        {
          "name": "Refresh After Logout",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.test(\"Status code is 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Success flag is false\", () => pm.expect(json.success).to.eql(false));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{lastRefreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Uses the revoked refresh token. The backend must return 401."
          },
          "response": []
        }
      ]
    },
    {
